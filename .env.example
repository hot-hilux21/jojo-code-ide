# Copy to .env on the server (never commit .env). run.sh loads this file.
#
# Marks the process as the public web copy, so the quit button is refused
# and the code runner is sandboxed.
WEB=1

# Port gunicorn binds. nginx proxies this.
PORT=3000

# Signs sessions. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. When set, the code runner and settings changes require this code.
# Leave unset to keep the runner open (the sandbox is the protection).
ACCESS_CODE=jojo12345

# Optional OAuth providers for cloud login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ADMIN_LOGIN=your-github-username

# Set to 1 only when the service runs behind a trusted reverse proxy that
# overwrites X-Forwarded-For. The runner uses this for per-reader rate limits.
#TRUST_PROXY=0
